# Copy to .env and fill in. Values entered in the admin UI (settings table) win
# over these for the OAuth client credentials.
PORT=3005
PUBLIC_BASE_URL=https://frostdev.io
HOMEPAGE_DATA_DIR=/opt/frostdev-homepage/data

# 32 bytes base64 — seals OAuth refresh tokens at rest. Generate:
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# Google Cloud OAuth client (Internal consent screen on the frostdev.io Workspace).
# Redirect URIs: {PUBLIC_BASE_URL}/api/auth/google/callback and /api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure app registration ("accounts in any organizational directory").
# Redirect URI: {PUBLIC_BASE_URL}/api/connect/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Notion public integration. Redirect URI: {PUBLIC_BASE_URL}/api/connect/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Weather widget location (defaults to Northern NJ if unset).
WEATHER_LAT=
WEATHER_LON=

# Absolute path to pm2 for the status engine when PATH doesn't carry it (nvm).
#PM2_BIN=/root/.nvm/versions/node/v22.23.2/bin/pm2

# Timezone for logic-engine clocks/due dates is set in ecosystem.config.cjs (TZ), not here.
