# Copy to .env and fill in. Read by `npm run dev:env`, `npm run preview`, the CLI
# (bin/rimeward.mjs) and your process manager — plain `astro dev` does not read it.

# The URL people reach the site on. Redirect URIs, the CSRF origin check and the
# Secure cookie flag (https only) all derive from it.
PUBLIC_BASE_URL=http://localhost:4321
PORT=3005
# Bind address: 127.0.0.1 behind a reverse proxy, 0.0.0.0 inside a container.
HOST=127.0.0.1

# Where the database, uploads and the agent's files live. Default: ./data
#HOMEPAGE_DATA_DIR=/var/lib/rimeward

# 32 bytes base64 — seals OAuth refresh tokens and every stored credential.
# Part of every backup: without it a restored database holds undecryptable tokens.
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# Google sign-in and the Gmail/Calendar links (a Google Cloud OAuth client).
# Redirect URIs: {PUBLIC_BASE_URL}/api/auth/google/callback and /api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A Google Workspace domain whose accounts may sign in without an invite (the
# first one becomes admin). Unset: only invited addresses can use Google
# sign-in (the admin page, or `node bin/rimeward.mjs users create --sso`).
#SSO_WORKSPACE_DOMAIN=example.com

# Microsoft (Outlook, Teams): an Azure app registration.
# Redirect URI: {PUBLIC_BASE_URL}/api/connect/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# A single-tenant registration: its tenant id. Default: common
#MS_TENANT_ID=

# Notion public integration. Redirect URI: {PUBLIC_BASE_URL}/api/connect/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Zoho Mail. Redirect URI: {PUBLIC_BASE_URL}/api/connect/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Weather ward location, decimal degrees. The weather_lat / weather_lon settings
# (`node bin/rimeward.mjs settings set weather_lat 40.7`) win over these.
WEATHER_LAT=
WEATHER_LON=

# Browser wards. Unset: playwright-core's own Chromium (`npx playwright-core
# install chromium`), sandboxed unless the server runs as root. A root-run
# server keeps the sandbox by pointing this at a wrapper that drops root.
#BROWSER_EXECUTABLE=/usr/local/bin/chromium-unprivileged
# Browser profiles; default {data dir}/browser. Put it outside the data dir when
# chromium runs as another user.
#BROWSER_PROFILES=/var/lib/rimeward-browser

# Status engine: the binaries behind pm2 / docker / systemd targets when PATH
# does not carry them (nvm installs). A missing one shows "not installed".
#PM2_BIN=/root/.nvm/versions/node/v22.23.2/bin/pm2
#DOCKER_BIN=/usr/bin/docker
#SYSTEMCTL_BIN=/usr/bin/systemctl

# Build stamp on the dashboard; default: v<package version>.
#PUBLIC_APP_BUILD=v1.0.0 abc1234

# Timezone for the logic engine's clocks and due dates: set TZ in the process
# manager (pm2 env, systemd Environment=, compose environment), not here —
# Node reads it before .env is loaded.
