{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rimeward",
  "version": "0.1.2",
  "identifier": "io.frostdev.rimeward",
  "build": {
    "frontendDist": "https://frostdev.io/dash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rimeward",
        "url": "https://frostdev.io/dash",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
