{
  "name": "rimeward",
  "type": "module",
  "version": "0.20.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "rimeward": "bin/rimeward.mjs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./server.mjs",
    "test": "node --test 'tests/*.test.ts'",
    "dev:env": "node --env-file-if-exists=.env node_modules/astro/astro.js dev",
    "desktop:dev": "node desktop/prebuild.mjs && cd desktop && cargo tauri dev",
    "desktop:build": "node desktop/prebuild.mjs && cd desktop && cargo tauri build",
    "cli": "node bin/rimeward.mjs",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node bin/prepare-pty.mjs",
    "test:ui": "node tests/editor-ui-smoke.mjs && node tests/terminal-ui-smoke.mjs && node tests/conversation-ui-smoke.mjs && node tests/remote-workspace-smoke.mjs",
    "test:standalone": "node tests/standalone-smoke.mjs",
    "goldens": "node ops/goldens.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@biomejs/biome": "2.5.12",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify-json/meteocons": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/utils": "^3.1.4",
    "@openrouter/sdk": "^1.2.84",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.16.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "astro": "^5.18.2",
    "better-sqlite3": "^12.11.1",
    "codemirror": "6.0.2",
    "imapflow": "^1.7.7",
    "just-bash": "^3.4.2",
    "mailparser": "^3.9.19",
    "motion": "^13.0.0",
    "node-pop3": "^0.15.0",
    "node-pty": "1.1.0",
    "nodemailer": "^9.1.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
